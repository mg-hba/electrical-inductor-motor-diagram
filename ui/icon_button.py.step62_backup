"""
================================================================================
File: ui/icon_button.py
Purpose: IconButton + IconTextButton.
         - IconButton: only image, behaves like button.
         - IconTextButton: icon + label, entire row clickable.
Version: 0.1.2.0
================================================================================
"""

import os
from kivy.uix.button import Button
from kivy.uix.image import Image
from kivy.uix.label import Label
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.behaviors import ButtonBehavior
from kivy.graphics import Color, Rectangle
from kivy.metrics import dp

from ui.theme import Theme


BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ICONS_DIR = os.path.join(BASE_DIR, 'assets', 'icons')


ICON_SUBFOLDERS = [
    'main', 'menu', 'zoom', 'connection', 'conflict',
    'app_info', 'docs', 'setup', 'file_ops', 'common', 'misc',
]


def get_icon_path(icon_name):
    """Resolve icon_name to full path in assets/icons/<subfolder>/."""
    if not icon_name:
        return ''
    for sub in ICON_SUBFOLDERS:
        p = os.path.join(ICONS_DIR, sub, icon_name + '.png')
        if os.path.exists(p):
            return p
    p = os.path.join(ICONS_DIR, icon_name + '.png')
    if os.path.exists(p):
        return p
    for sub in ICON_SUBFOLDERS:
        p = os.path.join(ICONS_DIR, sub, icon_name + '.svg')
        if os.path.exists(p):
            return p
    p = os.path.join(ICONS_DIR, icon_name + '.svg')
    if os.path.exists(p):
        return p
    return ''


# ============================================================
# ==================== ICON BUTTON ===========================
# ============================================================

class IconButton(ButtonBehavior, Image):
    """Image that behaves like a button."""
    pass


def make_icon_button(text, icon_name, on_press,
                     size_hint=(None, None), size=(dp(38), dp(30)),
                     font_size='12sp',
                     bg_color=None,
                     fg_color=None):
    """
    If PNG exists: returns an IconButton (image only).
    Else: returns a normal Button with text.
    """
    icon_path = get_icon_path(icon_name)
    bg = bg_color if bg_color else Theme.BUTTON_PRIMARY_BG
    fg = fg_color if fg_color else [1, 1, 1, 1]

    if icon_path:
        btn = IconButton(source=icon_path,
                         size_hint=size_hint, size=size,
                         allow_stretch=True,
                         keep_ratio=True)
    else:
        btn = Button(text=text,
                     size_hint=size_hint, size=size,
                     font_size=font_size,
                     background_color=bg,
                     color=fg,
                     background_normal='')

    if on_press:
        btn.bind(on_press=on_press)
    return btn


# ============================================================
# ================ ICON + TEXT BUTTON ========================
# ============================================================

class IconTextButton(ButtonBehavior, BoxLayout):
    """
    A clickable row: [icon] [text]
    The entire row is clickable (ButtonBehavior on the BoxLayout).
    """

    def __init__(self, text='', icon_name='', on_press=None,
                 height=dp(38), icon_size=dp(26),
                 font_size='13sp',
                 bg_color=None,
                 fg_color=None,
                 align='left',
                 padding=(dp(8), dp(2), dp(8), dp(2)),
                 **kwargs):
        super().__init__(orientation='horizontal',
                         size_hint_y=None, height=height,
                         spacing=dp(8), padding=padding,
                         **kwargs)

        self.bg_color = bg_color if bg_color else [0.97, 0.97, 0.97, 1]
        self.fg_color = fg_color if fg_color else [0.1, 0.1, 0.1, 1]
        self._on_press_cb = on_press

        # Background
        with self.canvas.before:
            Color(*self.bg_color)
            self._bg = Rectangle(pos=self.pos, size=self.size)
        self.bind(pos=self._update_bg, size=self._update_bg)

        # Icon (or empty placeholder)
        icon_path = get_icon_path(icon_name)
        if icon_path:
            img = Image(source=icon_path,
                        size_hint=(None, 1),
                        width=icon_size,
                        allow_stretch=True,
                        keep_ratio=True)
            self.add_widget(img)
        else:
            # Placeholder so text stays aligned
            self.add_widget(Label(size_hint=(None, 1), width=icon_size))

        # Text
        lbl = Label(text=text,
                    font_size=font_size,
                    color=self.fg_color,
                    halign=align,
                    valign='middle',
                    size_hint_x=1)
        lbl.bind(size=lambda i, v: setattr(i, 'text_size', v))
        self.add_widget(lbl)

    def _update_bg(self, *args):
        self._bg.pos = self.pos
        self._bg.size = self.size

    def on_press(self):
        if self._on_press_cb:
            self._on_press_cb(self)

    def on_release(self):
        pass

    def set_text(self, value):
        for child in self.children:
            if isinstance(child, Label):
                child.text = value
                return

    def set_bg_color(self, color):
        self.bg_color = color
        self.canvas.before.clear()
        with self.canvas.before:
            Color(*color)
            self._bg = Rectangle(pos=self.pos, size=self.size)


def make_icon_text_button(text, icon_name, on_press,
                          height=dp(38),
                          icon_size=dp(26),
                          font_size='13sp',
                          bg_color=None,
                          fg_color=None,
                          align='left'):
    return IconTextButton(text=text, icon_name=icon_name,
                          on_press=on_press,
                          height=height, icon_size=icon_size,
                          font_size=font_size,
                          bg_color=bg_color,
                          fg_color=fg_color,
                          align=align)